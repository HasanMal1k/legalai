# Python
.venv/
__pycache__/
*.pyc

# Secrets (keys come from the environment; never commit them)
.env
.env.*

# Source PDFs (about 37 GB)
data/**/raw_pdfs/
data/raw_pdfs/

# Full statute text: several files exceed GitHub's 100 MB limit; rebuild with the pipeline
data/**/statutes.jsonl
data/statutes.jsonl
data/**/repaired_text_backup.jsonl
data/repaired_text_backup.jsonl

# Chunks: the repository carries them gzipped (chunks.jsonl.gz); `python pack_data.py unpack` writes these
data/**/chunks.jsonl
data/chunks.jsonl

# The Qdrant database is rebuilt from data/embeddings/ (which is committed) with `python -m app.vectordb`;
# data/app/ holds the app's caches (rebuilt on start) and its question and feedback log (private)
data/qdrant/
data/app/

# Logs
*.log

# Qdrant binary; download it separately (config.yaml is kept)
tools/qdrant/*
!tools/qdrant/config.yaml

# Sindh High Court case corpus (out of scope for the app)
pakistan_cases/

# Kept on disk only
main.original.py
src/
ARCHITECTURE_INTERVIEW_PREP.md
